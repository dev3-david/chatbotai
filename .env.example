# Local Docker (docker compose up -d mongo):
MONGODB_URI=mongodb://tourism:tourism@127.0.0.1:27018/tourism_bot?authSource=admin
# MongoDB Atlas instead (Database Access user + Network Access rule required):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tourism_bot

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# First admin, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Chatbot tuning
# Cosine similarity (0..1) below which the bot answers "I don't know yet"
CONFIDENCE_THRESHOLD=0.5
# Multilingual embedding model (Hebrew + English, 384 dimensions). Downloaded once into .cache/transformers
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# Weight precision: q8 (small download, default) or fp32
EMBEDDING_DTYPE=q8
